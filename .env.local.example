# ===== ActionLoop 本地开发环境变量（示例，复制为 .env.local 后填写；.env.local 不提交）=====

# ---- PostgreSQL ----
# Docker 路径默认 5432；若复用本机已有 PG 或自建集群，可改端口（如本地独立集群 5433）
ACTIONLOOP_DB_HOST=127.0.0.1
ACTIONLOOP_DB_PORT=5432
ACTIONLOOP_DB_NAME=actionloop
ACTIONLOOP_DB_USER=postgres
ACTIONLOOP_DB_PASSWORD=change_me

# ---- Redis ----
ACTIONLOOP_REDIS_HOST=127.0.0.1
ACTIONLOOP_REDIS_PORT=6379
ACTIONLOOP_REDIS_PASSWORD=

# ---- MinIO / S3 兼容对象存储 ----
ACTIONLOOP_S3_ENDPOINT=http://127.0.0.1:9000
ACTIONLOOP_S3_REGION=us-east-1
ACTIONLOOP_S3_ACCESS_KEY=actionloop_minio_dev
ACTIONLOOP_S3_SECRET_KEY=change_me_minio_secret
ACTIONLOOP_S3_BUCKET=actionloop-dev

# ---- 后端 ----
ACTIONLOOP_API_PORT=8080
ACTIONLOOP_WORKER_PORT=8081
# 仅本地/dev 使用，生产必须通过密钥管理注入
ACTIONLOOP_JWT_SECRET=change_me_jwt_secret_at_least_32_bytes_long
ACTIONLOOP_REFRESH_TTL_DAYS=30
ACTIONLOOP_ACCESS_TTL_MINUTES=15

# ---- AI Provider（未配置真实密钥时使用确定性测试 Provider，明确标记）----
ACTIONLOOP_AI_PROVIDER=deterministic
ACTIONLOOP_AI_API_KEY=
ACTIONLOOP_AI_BASE_URL=
ACTIONLOOP_AI_MODEL=

# ---- 向量模型 ----
ACTIONLOOP_EMBEDDING_MODEL=bge-m3
ACTIONLOOP_EMBEDDING_DIM=1024

# ---- TURN（远程协助，开发可留空）----
ACTIONLOOP_TURN_HOST=
ACTIONLOOP_TURN_PORT=3478
ACTIONLOOP_TURN_SECRET=

# ---- 演示数据 ----
ACTIONLOOP_SEED_DEMO=true

# ---- 接口文档（仅开发/测试开启，生产保持 false）----
ACTIONLOOP_API_DOCS_ENABLED=false
ACTIONLOOP_API_DOCS_PUBLIC=false
