{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ActionLoop",
  "version": "0.1.0-beta.1",
  "identifier": "com.actionloop.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @actionloop/web dev",
    "beforeBuildCommand": "pnpm --filter @actionloop/web build"
  },
  "app": {
    "windows": [
      {
        "title": "ActionLoop · 日常生活行动系统",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://localhost:8080 https://localhost:8080 ws://localhost:5173 ws://localhost:8080 wss://localhost:8080;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
