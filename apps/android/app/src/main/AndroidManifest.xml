<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 跨 App 引导：悬浮层 + 前台屏幕采集（MediaProjection 每次单独授权，不缓存） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:name=".ActionLoopApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ActionLoop"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ActionLoop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 只读通知采集：用户授权 + 本地白名单 + 敏感词本地丢弃 + 不执行任何通知操作 -->
        <service
            android:name=".notifications.NotificationCaptureService"
            android:exported="true"
            android:label="ActionLoop 通知采集"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 本机提醒闹钟触发：仅应用内显式 Intent 唤起，不导出、不接受外部广播 -->
        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false" />

        <!-- 开机后从本地缓存重建提醒闹钟（离线可用） -->
        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 屏幕采集前台服务：仅采集不落盘；撤销授权/锁屏/停止按钮即停；不导出 -->
        <service
            android:name=".assist.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 只读无障碍服务：只读取控件文本与位置，不执行任何操作；系统绑定 -->
        <service
            android:name=".assist.GuidanceAccessibilityService"
            android:exported="true"
            android:label="ActionLoop 只读引导"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guidance_accessibility_service" />
        </service>
    </application>

</manifest>
